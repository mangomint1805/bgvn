{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$ns": {
        ".validate": "$ns.matches(/^bgvn-[a-z0-9]{2,12}$/)",
        "$code": {
          ".read": "$code.matches(/^[A-Z0-9]{5}$/)",
          ".write": "$code.matches(/^[A-Z0-9]{5}$/)",
          "alive": {
            ".validate": "newData.isNumber()"
          },
          "h": {
            "$id": {
              ".validate": "newData.hasChild('from') && newData.child('from').isString() && newData.child('from').val().length < 20 && (newData.child('bye').exists() || (newData.child('s').isString() && newData.child('s').val().length < 200000))"
            }
          },
          "c": {
            "$client": {
              ".validate": "$client.length < 20",
              "$id": {
                ".validate": "newData.child('s').isString() && newData.child('s').val().length < 200000"
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "feedback": {
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['t','msg','ts'])",
        "t": {
          ".validate": "newData.isString() && newData.val().matches(/^(bug|idea|other)$/)"
        },
        "msg": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 2000"
        },
        "game": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "contact": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "page": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "ts": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}