{
  // Máy chủ phòng chơi BGVN – Cloudflare Workers + Durable Objects (gói Free, SQLite)
  "name": "bgvn-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "api.boardgamevui.com", "custom_domain": true }],
  // địa chỉ dự phòng bgvn-rooms.<tài khoản>.workers.dev – dùng khi tên miền riêng gặp sự cố
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "INBOX", "class_name": "Inbox" },
      { "name": "USERS", "class_name": "Users" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Inbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Users", "Lobby"] }
  ],
  "observability": { "enabled": true },
  // PLAN: "free" (gói miễn phí, hạn mức theo ngày) hoặc "paid" (gói Workers Paid 5 USD/tháng) – để trang Quản trị tính % hạn mức cho đúng
  // Client ID đăng nhập Google (công khai, không phải bí mật) – Google Cloud project bgvn-514316
  "vars": { "PLAN": "free", "GOOGLE_CLIENT_ID": "743609743476-9qrmaq0mrn5m2jm2p0664m7v717qdr4e.apps.googleusercontent.com" },
  // giữ biến/mật khẩu đặt trên trang Cloudflare khi deploy lại từ GitHub
  "keep_vars": true
}
